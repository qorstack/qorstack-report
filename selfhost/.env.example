# =============================================================================
# Qorstack Report — self-host configuration
#
# Quick start:
#   bash init.sh            # copies this file to .env and fills every change-me-* with random secrets
#   docker compose up -d    # then open http://localhost:8080 (web UI; the API is under /api)
#
# Every value below works as-is on one machine (localhost). Only the lines marked
# "PRODUCTION" need changing when you put the stack behind a real domain.
# =============================================================================


# ── Admin account ────────────────────────────────────────────────────────────
# The system admin is re-synced from these values on EVERY backend start.
# To rotate the password: change it here, then `docker compose up -d` again.
# ADMIN_EMAIL may be a plain username (e.g. "admin") or an e-mail address.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin


# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Defaults point at the bundled `postgres` container. To use an external database,
# set DB_HOST/DB_PORT to it and remove the postgres service from docker-compose.yml.
DB_HOST=qorstack-postgres
DB_PORT=5432
DB_NAME=qorstack_report
DB_USER=postgres
# Password for the bundled container AND the backend connection (generated by init.sh).
DB_PASSWORD=change-me-db-password


# ── File storage (S3) ────────────────────────────────────────────────────────
# Storage server: RustFS (Apache-2.0) is bundled and starts by default — nothing to set.
# To use something else, uncomment ONE line (Docker Compose reads COMPOSE_FILE from this file):
#   bundled MinIO instead of RustFS (v1 installs that keep their MinIO data):
# COMPOSE_FILE=docker-compose.yml:docker-compose.minio.yml
#   no bundled server — external S3 (AWS S3, Cloudflare R2, your own MinIO/RustFS); set STORAGE_* below:
# COMPOSE_FILE=docker-compose.yml:docker-compose.external-s3.yml
# Keeps ":" as the COMPOSE_FILE separator on every OS (Windows defaults to ";").
COMPOSE_PATH_SEPARATOR=:
# Address the backend + font-syncer use INSIDE the Docker network (host:port, no scheme).
# "qorstack-storage" is the network alias of the bundled server (RustFS or MinIO).
STORAGE_ENDPOINT=qorstack-storage:9000
# true only when STORAGE_ENDPOINT speaks HTTPS (e.g. AWS S3: s3.eu-central-1.amazonaws.com).
STORAGE_USE_SSL=false
# Region — most self-hosted servers accept the default. AWS S3: your bucket's region.
STORAGE_REGION=us-east-1
# Credentials. For the bundled server these BECOME its root user/password (first start only).
# The access key must not contain "/". STORAGE_SECRET_KEY is generated by init.sh.
STORAGE_ACCESS_KEY=qorstack
STORAGE_SECRET_KEY=change-me-storage-secret
# The ONE bucket that holds everything. Created automatically on start, with folders:
#   template/          uploaded Word / Excel templates
#   generated-report/  generated files, sandbox assets, temporary downloads (deleted after 1 day)
#   fonts/             fonts uploaded from the Fonts page (mirrored to Gotenberg by font-syncer)
STORAGE_BUCKET=qorstack-report
# Storage does NOT need a public address: every download link points at the API
# ({PUBLIC_URL}/api/files/...), which streams the file. Port 9000 is not published.
# Already serve storage on its own public address (e.g. https://storage.example.com)? Set it here and
# download links become presigned URLs for that address (browsers fetch from storage directly, as in v1).
# STORAGE_PUBLIC_ENDPOINT=
#
# Upgrading from v1? Your old .env has MINIO_* names — they still work (STORAGE_* wins when
# both are set). Before starting v2, copy the old data once: `bash migrate-storage.sh`
# (see README › Upgrading to v2).


# ── Image URLs in render requests ────────────────────────────────────────────
# Image / QR-logo URLs are downloaded by the backend. For safety it refuses private and
# internal addresses (localhost, 10.x, 172.16–31.x, 192.168.x, 100.64–127.x, cloud metadata).
# Set true ONLY if your images live on an intranet server and every API-key holder is trusted.
IMAGE_FETCH_ALLOW_PRIVATE_NETWORKS=false

# ── Render request limits ────────────────────────────────────────────────────
# Protect the server from oversized render requests. 0 = unlimited.
# A request over a limit gets 400 naming the field and the setting to raise.
# Max request body in MB (keep it below your reverse proxy limit, e.g. nginx client_max_body_size).
RENDER_MAX_BODY_MB=30
# Max rows in one table.
RENDER_MAX_TABLE_ROWS=50000
# Max items in each of replace / image / qrcode / barcode.
RENDER_MAX_ITEMS_PER_FIELD=1000

# ── Project export / import (Pro) ────────────────────────────────────────────
# Largest project ZIP accepted by Export & import → Import (MB). Keep it below your reverse proxy limit.
PROJECT_IMPORT_MAX_MB=200


# ── Async renders + webhooks (Pro) ───────────────────────────────────────────
# "async": true queues a render and returns 202 with a job id; poll GET /render/jobs/{id}.
# Jobs are stored in PostgreSQL (report_jobs): they survive restarts, and several backend
# replicas can share the queue. A job whose worker dies is picked up again when its lease ends;
# network/storage/Gotenberg errors are retried (after 10 s, then 60 s, 3 tries in total).
# Parallel async renders per backend (each uses CPU + one Gotenberg conversion).
RENDER_ASYNC_WORKERS=2
# How long a worker may hold a job before another worker can take it over (renewed while rendering).
RENDER_JOB_LEASE_SECONDS=300
# Workers are woken instantly (LISTEN/NOTIFY); this poll is the fallback.
RENDER_POLL_SECONDS=5
# Unfinished async renders allowed per user; more → 429 Too Many Requests.
RENDER_MAX_PENDING_JOBS_PER_USER=100
# Webhooks are tried 3 times (now, +10 s, +60 s); delivery state is stored, so restarts only delay them.
# Secret for the X-Qorstack-Signature header on webhook POSTs (sha256=HMAC of the body).
# Generated by init.sh; empty = unsigned webhooks.  Generate: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=change-me-webhook-signing-secret
# Webhooks to private / internal addresses are refused unless this is true (same rule as image URLs).
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# ── Security keys (generated by init.sh — never reuse the examples) ──────────
# JWT signing key, at least 32 characters.  Generate: openssl rand -hex 24
JWT_KEY=change-me-jwt-signing-key-at-least-32-chars
# AES key for stored secrets, EXACTLY 32 characters.  Generate: openssl rand -hex 16
# Do not change after first start — data encrypted with the old key can no longer be read.
ENCRYPTION_KEY=change-me-encryption-key-32char!
# AES IV, EXACTLY 16 characters.  Generate: openssl rand -hex 8
ENCRYPTION_IV=change-me-iv-16!


# ── Web app + API (one container, one port) ──────────────────────────────────
# Host port. Open http://localhost:8080 for the web UI; the API is http://localhost:8080/api
APP_PORT=8080
# The address people open (put in download links: {PUBLIC_URL}/api/files/...).
# PRODUCTION: e.g. https://report.example.com
PUBLIC_URL=http://localhost:8080
# Only needed for browser apps on OTHER origins that call the API directly. Comma-separated.
# The built-in web UI is on the same origin and needs nothing here.
CORS_ORIGINS=
# Sign-in cookies follow the address in the browser: Secure on https://, plain on http:// (a NodePort,
# an intranet IP), so both work with no setting. Set true/false only to force one.
# AUTH_COOKIE_SECURE=

# ── Social sign-in (optional) ────────────────────────────────────────────────
# Leave empty to sign in with username/password only.
# Google: OAuth client id (Google Cloud Console → Credentials), authorised origin = PUBLIC_URL.
GOOGLE_CLIENT_ID=
# GitHub: OAuth app (github.com/settings/developers), callback = {PUBLIC_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ── Image versions ───────────────────────────────────────────────────────────
# Leave unset to track :latest, or pin a release for reproducible deploys.
# REPORT_TAG=2.3.1
