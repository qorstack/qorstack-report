{
  "name": "qorstack-report-sdk",
  "version": "2.3.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "sync-config": "node scripts/sync-config.js",
    "prebuild": "pnpm sync-config",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "gen:swagger": "bash ../backend/gen-swagger-sdk.sh && node -e \"require('fs').copyFileSync('../backend/swagger-sdk.json','src/qorstack-swagger.json')\"",
    "gen:nodejs": "swagger-typescript-api generate -p ../backend/swagger-sdk.json -o ./src/nodejs --name QorstackApi.ts",
    "gen:dotnet": "nswag openapi2csclient /input:../backend/swagger-sdk.json /output:src/dotnet/QorstackApi.cs /namespace:Qorstack.Report.Sdk /ClassName:QorstackApi && node scripts/fix-dotnet.js",
    "gen:all": "pnpm gen:nodejs && pnpm gen:dotnet"
  },
  "keywords": [
    "qorstack",
    "report",
    "sdk",
    "pdf",
    "word"
  ],
  "author": "Qorstack",
  "license": "MIT",
  "description": "Qorstack Report SDK for Node.js and .NET",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qorstack/qorstack-report.git"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "nswag": "^14.6.3",
    "swagger-typescript-api": "13.12.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "defu": "6.1.5"
    }
  }
}
