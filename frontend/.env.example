# =============================================================================
# Qorstack Report — frontend env (OPTIONAL)
#
# Local development needs NOTHING here: use the repo-root .env (see ../.env.dev.example).
# `pnpm dev` proxies /api to the backend (DEV_BACKEND_URL from the root .env, default http://localhost:5000),
# and the backend serves Google/GitHub client ids at runtime (GET /api/app-config).
#
# These variables are only for the Vercel / marketing build, or for pointing the web app at an API on
# another origin. NEXT_PUBLIC_* values are inlined at BUILD time and visible to every browser —
# never put secrets in them.
# =============================================================================

# Build target: "marketing" builds the landing/docs site only (Vercel).
# BUILD_TARGET=

# "cloud" = marketing site mode (landing at /, /login redirects to /).
# NEXT_PUBLIC_SITE_MODE=

# API on another origin (split setups only). "/api" is appended if missing. Default: same origin /api.
# NEXT_PUBLIC_SERVICE=https://report.example.com

# Fallback OAuth client ids when /api/app-config is not reachable (marketing build).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Branding
# NEXT_PUBLIC_BRAND_NAME=Qorstack Report
# NEXT_PUBLIC_TWITTER_HANDLE=@qorstack_report
# NEXT_PUBLIC_BRAND_TWITTER=qorstack_report
# NEXT_PUBLIC_GITHUB_URL=https://github.com/qorstack/qorstack-report
