{
  "name": "nextjs-heroui-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/sync-selfhost-public.mjs",
    "dev": "env-cmd -f .env next dev --turbopack -p 3000",
    "prebuild": "node scripts/sync-selfhost-public.mjs && node scripts/sync-pdf-assets.mjs",
    "build": "next build --webpack",
    "build:icons": "tsx src/iconify-bundle/bundle-icons-react.mts",
    "start": "next start",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "preprocess-generated": "node ./src/api/generated/configs/pre-processor.js",
    "postprocess-generated": "node ./src/api/generated/configs/post-processor.js",
    "generate": "pnpm swagger-typescript-api generate -p ./src/api/generated/configs/main-service.swagger.json -o ./src/api/generated/main-service -n apiGenerated.ts --axios --unwrap-response-data",
    "prepare": "husky",
    "postinstall": "node scripts/sync-pdf-assets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/modifiers": "7.0.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/is-prop-valid": "1.2.2",
    "@heroui/react": "2.7",
    "@hookform/resolvers": "5.2.0",
    "@iconify/react": "4.1.1",
    "@react-oauth/google": "0.13.4",
    "@reduxjs/toolkit": "2.0.1",
    "@tanstack/react-query": "5.17.12",
    "@types/prismjs": "1.26.5",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vercel/analytics": "1.6.1",
    "autoprefixer": "10.0.1",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "dayjs": "1.11.10",
    "dotenv": "16.4.5",
    "env-cmd": "10.1.0",
    "framer-motion": "12.4.3",
    "i18next": "23.15.1",
    "i18next-browser-languagedetector": "8.0.0",
    "i18next-http-backend": "3.0.5",
    "iconify-icon": "2.3.0",
    "js-cookie": "3.0.8",
    "lightbox.js-react": "1.1.4",
    "next": "16.3.8",
    "next-themes": "0.4.4",
    "pdfjs-dist": "4.10.38",
    "postcss": "8.5.28",
    "qorstack-report-sdk": "0.0.1",
    "qrcode-generator": "2.0.4",
    "react": "19",
    "react-day-picker": "8.10.0",
    "react-dom": "19",
    "react-dropzone": "14.2.3",
    "react-hook-form": "7.51.5",
    "react-i18next": "15.0.2",
    "react-modern-drawer": "1.2.2",
    "react-pdf": "9.2.1",
    "react-redux": "9.1.0",
    "react-simple-code-editor": "0.14.1",
    "react-syntax-highlighter": "16.1.0",
    "recharts": "2.12.7",
    "redux": "5.0.1",
    "refractor": "5.0.0",
    "socket.io-client": "4.7.5",
    "swiper": "12.2.0",
    "tailwind-merge": "2.3.0",
    "use-debounce": "10.0.3",
    "usehooks-ts": "3.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yup": "1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3",
    "@iconify-json/solar": "1.2.2",
    "@iconify/json": "2.2.34",
    "@iconify/tools": "5.0.14",
    "@iconify/types": "2.0.0",
    "@iconify/utils": "2.1.5",
    "@tauri-apps/cli": "1.6.1",
    "@types/js-cookie": "3.0.6",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "9",
    "eslint-config-next": "16",
    "husky": "9",
    "lint-staged": "15",
    "prettier": "3.2.5",
    "prettier-plugin-tailwindcss": "0.5.14",
    "swagger-typescript-api": "13.13.0",
    "tailwindcss": "3.4.1",
    "tsx": "4.20.6",
    "typescript": "5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "neverBuiltDependencies": [
      "canvas"
    ],
    "overrides": {
      "js-yaml": "4.3.2",
      "axios": "1.20.0",
      "js-cookie": "3.0.8",
      "follow-redirects": "1.16.0",
      "yaml@^1.0.0": "1.10.3",
      "yaml@^2.0.0": "2.9.1",
      "baseline-browser-mapping": "2.11.26",
      "tar": "7.5.22",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.7",
      "minimatch": "9.0.9",
      "ws": "8.22.0",
      "postcss": "8.5.28",
      "lodash": "4.18.1",
      "sharp": "0.35.5",
      "browserslist": "4.29.3",
      "undici": "6.29.0",
      "brace-expansion@^5.0.0": "5.0.12",
      "brace-expansion@^2.0.0": "2.1.7",
      "brace-expansion@^1.0.0": "1.1.21",
      "form-data": "4.0.6",
      "i18next-http-backend": "3.0.5",
      "swagger-typescript-api@^13.0.0": "13.13.0",
      "glob": "10.5.0",
      "defu": "6.1.7",
      "swiper": "12.2.0",
      "nanoid@^3.0.0": "3.3.19",
      "nanoid@^5.0.0": "5.1.16",
      "flatted": "3.4.4",
      "socket.io-parser": "4.2.7",
      "next": "16.3.8",
      "@humanfs/node": "0.16.8",
      "@iconify/tools": "5.0.14",
      "pdfjs-dist": "4.10.38",
      "svgo@>=3.0.0 <3.3.5": "3.3.5",
      "svgo@>=4.0.0 <4.1.0": "4.1.0",
      "@babel/core@>=7.0.0 <7.29.6": "7.29.6"
    }
  }
}
